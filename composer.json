{
  "name": "itmosoft/laravel-shipping",
  "description": "Shipping zones, methods, rates, quotes, shipments and tracking for Laravel applications.",
  "keywords": ["laravel", "shipping", "delivery", "ecommerce", "rates", "tracking"],
  "license": "MIT",
  "require": {"php": "^8.3", "illuminate/contracts": "^12.0|^13.0", "illuminate/database": "^12.0|^13.0", "illuminate/support": "^12.0|^13.0"},
  "require-dev": {"orchestra/testbench": "^10.0|^11.0", "phpunit/phpunit": "^11.0|^12.0"},
  "autoload": {"psr-4": {"ItmoSoft\\Shipping\\": "src/"}},
  "autoload-dev": {"psr-4": {"ItmoSoft\\Shipping\\Tests\\": "tests/"}},
  "extra": {"laravel": {"providers": ["ItmoSoft\\Shipping\\ShippingServiceProvider"]}},
  "scripts": {"test": "phpunit"},
  "minimum-stability": "stable", "prefer-stable": true
}